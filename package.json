{
  "name": "music-space",
  "version": "0.21.0-rc.1",
  "private": true,
  "type": "module",
  "description": "Music Space: after the show, concert-goers trade the view the other one missed, by consent, as a two-name double ticket",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "ai:ort": "node scripts/ai/copy-ort.mjs",
    "ai:check": "node scripts/ai/check-dist.mjs",
    "predev": "npm run ai:ort",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "npm run ai:ort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "server": "node --watch server/index.js",
    "start": "node server/index.js",
    "dev:avatar": "vite --config vite.avatar.config.js",
    "build:avatar": "vite build --config vite.avatar.config.js",
    "test:avatar": "node --test tests/avatar*.test.js",
    "test": "node scripts/test/moment.test.mjs && node scripts/test/insight.test.mjs && node scripts/test/api.test.mjs",
    "test:runtime": "node --test runtime-preview/tests/avatar*.test.mjs",
    "build:all": "npm run build && npm run build:avatar && npm run build:livehouse && npm run build:character && npm run build:event && npm run build:map",
    "build:livehouse": "vite build --config vite.livehouse.config.js",
    "dev:livehouse": "vite --config vite.livehouse.config.js",
    "build:character": "vite build --config vite.character.config.js",
    "test:event": "node --test tests/event-api.test.js runtime-preview/tests/event-worker.test.mjs",
    "test:event-exchanges": "node --test tests/event-exchanges.test.js tests/event-exchange-controller.test.js",
    "test:event-moderation": "node --test tests/event-moderation.test.js tests/event-moderation-controller.test.js tests/event-moderation-panel.test.js",
    "test:character": "node web/character-lab/check-character.mjs",
    "build:event": "vite build --config vite.event.config.js",
    "dev:event": "vite --config vite.event.config.js",
    "test:event-client": "node --test tests/event-client.test.js tests/event-room-binding.test.js",
    "test:event-social": "node --test tests/event-social.test.js tests/event-social-controller.test.js",
    "test:event-chat": "node --test tests/event-chat.test.js tests/event-chat-controller.test.js tests/event-chat-notice.test.js",
    "test:illustrated": "node --test tests/illustrated-avatar.test.js",
    "test:wardrobe": "node --test tests/event-wardrobe.test.js",
    "start:local": "node server/launch-local.js",
    "test:launcher": "node --test tests/local-launcher.test.js",
    "test:release": "node scripts/test/release-suite.mjs",
    "release:pack": "node scripts/release/package.mjs",
    "build:map": "vite build --config vite.map.config.js"
  },
  "devDependencies": {
    "gsap": "3.15.0",
    "onnxruntime-web": "1.30.0",
    "overlayscrollbars": "2.16.0",
    "qrcode-generator": "2.0.4",
    "three": "0.186.1",
    "vite": "8.3.1",
    "vite-plugin-singlefile": "2.3.3"
  }
}
