   "shot": "A3-A-type",
   "t0": 56.3709,
   "t1": 59.1323,
   "text": "拍摄时间，\n照片自己记得。",
   "role": "display",
   "kind": "title",
   "size": 128,
   "recipe": "ink-yellow",
   "script": "T052",
   "inFootage": false
  },
  {
   "id": "A3-A-type:62",
   "shot": "A3-A-type",
   "t0": 58.3064,
   "t1": 60.1,
   "text": "拍的是哪一面？",
   "role": "display",
   "kind": "title",
   "size": 128,
   "recipe": "ink-pink",
   "script": "T054",
   "inFootage": false
  },
  {
   "id": "A3-A-type:72",
   "shot": "A3-A-type",
   "t0": 60,
   "t1": 61.6726,
   "text": "人海。",
   "role": "display",
   "kind": "title",
   "size": 240,
   "recipe": "ink-pink",
   "script": "T055",
   "inFootage": false
  },
  {
   "id": "A3-A-type:73",
   "shot": "A3-A-type",
   "t0": 60.9678,
   "t1": 63.871,
   "text": "AI 在本机判断，",
