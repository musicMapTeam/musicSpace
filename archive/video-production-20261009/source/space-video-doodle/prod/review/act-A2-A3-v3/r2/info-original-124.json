   "text": "愿意打招呼，",
   "role": "display",
   "kind": "title",
   "size": 128,
   "recipe": "ink-pink",
   "script": "T045",
   "inFootage": false
  },
  {
   "id": "A2-E-type:26",
   "shot": "A2-E-type",
   "t0": 47.4194,
   "t1": 50.3226,
   "text": "还是\n安静参与？",
   "role": "display",
   "kind": "title",
   "size": 128,
   "recipe": "ink-mint",
   "script": "T046",
   "inFootage": false
  },
  {
   "id": "A2-E-type:27",
   "shot": "A2-E-type",
   "t0": 48.3871,
   "t1": 50.3226,
   "text": "自己选。",
   "role": "display",
   "kind": "title",
   "size": 128,
   "recipe": "st-yellow",
   "script": "T047",
   "inFootage": false
  },
  {
   "id": "A2-E4-type:44",
   "shot": "A2-E4-type",
   "t0": 50.3226,
   "t1": 54.1935,
   "text": "看看谁也在。",
   "role": "display",
   "kind": "title",
   "size": 128,
   "recipe": "ink-pink",
   "script": "T048",
   "inFootage": false
  },
  {
   "id": "A3-A-type:59",
   "shot": "A3-A-type",
   "t0": 54.1935,
   "t1": 56.3709,
   "text": "放一张\n今晚的照片。",
   "role": "display",
   "kind": "title",
   "size": 128,
   "recipe": "ink-yellow",
   "script": "T050",
   "inFootage": false
  },
  {
   "id": "A3-A-type:60",
   "shot": "A3-A-type",
   "t0": 56.3709,
   "t1": 58.3064,
   "text": "21:48",
   "role": "digits",
   "kind": "title",
