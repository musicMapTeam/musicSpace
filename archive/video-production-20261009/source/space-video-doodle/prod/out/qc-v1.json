    {
     "text": "TA 拍的",
     "kind": "label",
     "units": 3,
     "on_s": 4.65,
     "need_s": 0.8,
     "ok": true
    },
    {
     "text": "每部手机里，",
     "kind": "title",
     "units": 5,
     "on_s": 3.85,
     "need_s": 1.25,
     "ok": true
    },
    {
     "text": "只有自己那一面。",
     "kind": "title",
     "units": 7,
     "on_s": 2.9,
     "need_s": 1.75,
     "ok": true
    },
    {
     "text": "最好看的那张你，",
     "kind": "title",
     "units": 7,
     "on_s": 3.95,
     "need_s": 1.75,
     "ok": true
    },
    {
     "text": "你！",
     "kind": "note",
     "units": 1,
     "on_s": 1.1,
     "need_s": 0.8,
     "ok": true
    },
    {
     "text": "在陌生人的手机里。",
     "kind": "title",
     "units": 8,
     "on_s": 2.95,
     "need_s": 2.0,
     "ok": true
    },
    {
     "text": "陌生人的手机",
     "kind": "label",
     "units": 6,
     "on_s": 5.6,
     "need_s": 1.5,
     "ok": true
    },
    {
     "text": "散场后，",
     "kind": "title",
     "units": 3,
     "on_s": 2.9,
     "need_s": 0.8,
     "ok": true
    },
    {
     "text": "找不回来。",
     "kind": "title",
     "units": 4,
     "on_s": 1.9,
     "need_s": 1.0,
     "ok": true
    },
    {
     "text": "站在你身边的人，",
     "kind": "title",
     "units": 7,
     "on_s": 3.0,
     "need_s": 1.75,
     "ok": true
    },
    {
     "text": "还没认识，就走散了。",
     "kind": "title",
     "units": 8,
     "on_s": 3.0,
     "need_s": 2.0,
     "ok": true
    },
    {
     "text": "要是……",
     "kind": "title",
     "units": 2,
     "on_s": 2.0,
     "need_s": 0.8,
     "ok": true
    },
    {
     "text": "能把那一面，换回来？",
     "kind": "title",
     "units": 8,
     "on_s": 2.85,
     "need_s": 2.0,
     "ok": true
    },
    {
     "text": "同场的人，",
     "kind": "title",
     "units": 4,
     "on_s": 3.95,
     "need_s": 1.0,
     "ok": true
    },
    {
     "text": "再进同一间\nLivehouse。",
     "kind": "title",
     "units": 6,
     "on_s": 3.0,
     "need_s": 1.5,
     "ok": true
    },
    {
     "text": "带上你的小人，",
     "kind": "title",
     "units": 6,
     "on_s": 3.95,
     "need_s": 1.5,
     "ok": true
    },
    {
     "text": "断拍",
     "kind": "label",
     "units": 2,
     "on_s": 3.9,
     "need_s": 0.8,
     "ok": true
    },
    {
     "text": "循迹",
     "kind": "label",
     "units": 2,
     "on_s": 3.45,
     "need_s": 0.8,
     "ok": true
    },
