     "need_s": 0.8,
     "ok": false
    },
    {
     "text": "同一刻，",
     "kind": "title",
     "units": 3,
     "on_s": 14.65,
     "need_s": 0.8,
     "ok": true
    },
    {
     "text": "另一面。",
     "kind": "title",
     "units": 3,
     "on_s": 13.95,
     "need_s": 0.8,
     "ok": true
    },
    {
     "text": "MUSIC SPACE",
     "kind": "label",
     "units": 2,
     "on_s": 12.7,
     "need_s": 0.8,
     "ok": true
    },
    {
     "text": "和同场的人，交换彼此的视角。",
     "kind": "title",
     "units": 12,
     "on_s": 3.25,
     "need_s": 3.0,
     "ok": true
    },
    {
     "text": "散场了。",
     "kind": "title",
     "units": 3,
     "on_s": 0.95,
     "need_s": 0.8,
     "ok": true
    },
    {
     "text": "你拍了人海，",
     "kind": "title",
     "units": 5,
     "on_s": 3.0,
     "need_s": 1.25,
     "ok": true
    },
    {
     "text": "TA 拍了舞台。",
     "kind": "title",
     "units": 5,
     "on_s": 2.0,
     "need_s": 1.25,
     "ok": true
    },
    {
     "text": "你拍的",
     "kind": "label",
     "units": 3,
     "on_s": 4.8,
     "need_s": 0.8,
     "ok": true
    },
    {
     "text": "TA 拍的",
     "kind": "label",
     "units": 3,
     "on_s": 4.65,
     "need_s": 0.8,
     "ok": true
    },
    {
     "text": "每部手机里，",
     "kind": "title",
     "units": 5,
     "on_s": 3.85,
     "need_s": 1.25,
     "ok": true
    },
    {
     "text": "只有自己那一面。",
     "kind": "title",
     "units": 7,
     "on_s": 2.9,
     "need_s": 1.75,
     "ok": true
    },
    {
     "text": "最好看的那张你，",
     "kind": "title",
     "units": 7,
     "on_s": 3.95,
     "need_s": 1.75,
     "ok": true
    },
    {
     "text": "你！",
     "kind": "note",
     "units": 1,
     "on_s": 1.05,
     "need_s": 0.8,
     "ok": true
    },
    {
     "text": "在陌生人的手机里。",
     "kind": "title",
     "units": 8,
     "on_s": 2.95,
     "need_s": 2.0,
     "ok": true
    },
    {
     "text": "陌生人的手机",
     "kind": "label",
     "units": 6,
     "on_s": 5.6,
     "need_s": 1.5,
     "ok": true
    },
    {
     "text": "散场后，",
     "kind": "title",
     "units": 3,
     "on_s": 2.9,
     "need_s": 0.8,
     "ok": true
    },
    {
     "text": "找不回来。",
     "kind": "title",
     "units": 4,
     "on_s": 1.9,
     "need_s": 1.0,
     "ok": true
    },
    {
     "text": "站在你身边的人，",
     "kind": "title",
     "units": 7,
     "on_s": 3.0,
     "need_s": 1.75,
     "ok": true
    },
    {
     "text": "还没认识，就走散了。",
     "kind": "title",
     "units": 8,
     "on_s": 2.9,
     "need_s": 2.0,
     "ok": true
    },
    {
     "text": "要是……",
     "kind": "title",
     "units": 2,
     "on_s": 2.0,
     "need_s": 0.8,
     "ok": true
    },
    {
     "text": "能把那一面，换回来？",
     "kind": "title",
     "units": 8,
     "on_s": 2.85,
     "need_s": 2.0,
     "ok": true
    },
    {
     "text": "同场的人，",
     "kind": "title",
     "units": 4,
     "on_s": 3.9,
     "need_s": 1.0,
     "ok": true
    },
    {
     "text": "再进同一间\nLivehouse。",
     "kind": "title",
     "units": 6,
     "on_s": 2.95,
     "need_s": 1.5,
     "ok": true
    },
    {
     "text": "带上你的小人，",
     "kind": "title",
     "units": 6,
     "on_s": 3.95,
     "need_s": 1.5,
     "ok": true
    },
    {
     "text": "断拍",
     "kind": "label",
     "units": 2,
     "on_s": 3.9,
     "need_s": 0.8,
     "ok": true
    },
    {
     "text": "循迹",
     "kind": "label",
     "units": 2,
     "on_s": 3.45,
     "need_s": 0.8,
     "ok": true
    },
    {
     "text": "回声",
     "kind": "label",
     "units": 2,
     "on_s": 2.95,
     "need_s": 0.8,
     "ok": true
    },
    {
     "text": "失真",
     "kind": "label",
     "units": 2,
     "on_s": 2.45,
     "need_s": 0.8,
     "ok": true
    },
    {
     "text": "今晚，我这样。",
     "kind": "note",
     "units": 5,
     "on_s": 2.0,
     "need_s": 1.25,
     "ok": true
    },
    {
     "text": "愿意打招呼，",
     "kind": "title",
     "units": 5,
     "on_s": 2.0,
     "need_s": 1.25,
     "ok": true
    },
    {
     "text": "还是\n安静参与？",
     "kind": "title",
     "units": 6,
     "on_s": 2.85,
     "need_s": 1.5,
     "ok": true
    },
    {
     "text": "自己选。",
     "kind": "title",
     "units": 3,
     "on_s": 1.8,
     "need_s": 0.8,
     "ok": true
    },
    {
     "text": "看看谁也在。",
     "kind": "title",
     "units": 5,
     "on_s": 3.9,
     "need_s": 1.25,
     "ok": true
    },
    {
     "text": "放一张你的照片。",
     "kind": "title",
     "units": 7,
     "on_s": 1.95,
     "need_s": 1.75,
     "ok": true
    },
    {
     "text": "21:48",
     "kind": "title",
     "units": 1,
     "on_s": 1.9,
     "need_s": 0.8,
     "ok": true
    },
    {
     "text": "拍摄时间，\n照片自己记得。",
     "kind": "title",
     "units": 10,
     "on_s": 3.0,
     "need_s": 2.5,
     "ok": true
    },
    {
     "text": "拍的是哪一面？",
     "kind": "title",
     "units": 6,
     "on_s": 2.0,
     "need_s": 1.5,
     "ok": true
    },
    {
     "text": "人海。",
     "kind": "title",
     "units": 2,
     "on_s": 1.65,
     "need_s": 0.8,
     "ok": true
    },
    {
     "text": "AI 在本机判断，",
     "kind": "title",
     "units": 6,
     "on_s": 2.9,
     "need_s": 1.5,
     "ok": true
    },
    {
     "text": "照片不上传。",
     "kind": "title",
     "units": 5,
     "on_s": 1.95,
     "need_s": 1.25,
     "ok": true
    },
    {
     "text": "没把握的时候，",
     "kind": "title",
     "units": 6,
     "on_s": 2.0,
     "need_s": 1.5,
     "ok": true
    },
    {
     "text": "它就说不确定。",
     "kind": "title",
     "units": 6,
     "on_s": 2.0,
     "need_s": 1.5,
     "ok": true
    },
    {
     "text": "你来选。",
     "kind": "title",
     "units": 3,
     "on_s": 1.95,
     "need_s": 0.8,
     "ok": true
    },
    {
     "text": "保存，上墙。",
     "kind": "title",
     "units": 4,
     "on_s": 1.95,
     "need_s": 1.0,
     "ok": true
    },
    {
     "text": "上墙啦！",
     "kind": "note",
     "units": 3,
     "on_s": 0.95,
     "need_s": 0.8,
     "ok": true
    },
    {
     "text": "按拍摄时间，",
     "kind": "title",
     "units": 5,
     "on_s": 3.0,
     "need_s": 1.25,
     "ok": true
    },
    {
     "text": "3 分钟以内，",
     "kind": "title",
     "units": 5,
     "on_s": 1.9,
     "need_s": 1.25,
     "ok": true
    },
    {
     "text": "就是同一刻。",
     "kind": "title",
     "units": 5,
     "on_s": 2.0,
     "need_s": 1.25,
     "ok": true
    },
    {
     "text": "规则判断，不是 AI。",
     "kind": "title",
     "units": 7,
     "on_s": 2.0,
     "need_s": 1.75,
     "ok": true
    },
    {
     "text": "看这里！",
     "kind": "note",
     "units": 3,
     "on_s": 1.85,
     "need_s": 0.8,
     "ok": true
    },
    {
     "text": "你拍人海，",
     "kind": "title",
     "units": 4,
     "on_s": 3.9,
     "need_s": 1.0,
     "ok": true
    },
    {
     "text": "TA 拍舞台。",
     "kind": "title",
     "units": 4,
     "on_s": 2.9,
     "need_s": 1.0,
     "ok": true
    },
    {
     "text": "21:48:10",
     "kind": "label",
     "units": 1,
     "on_s": 2.4,
     "need_s": 0.8,
     "ok": true
    },
    {
     "text": "21:47:20",
     "kind": "label",
     "units": 1,
     "on_s": 2.2,
     "need_s": 0.8,
     "ok": true
    },
    {
     "text": "不到 1 分钟",
     "kind": "label",
     "units": 5,
     "on_s": 1.8,
     "need_s": 1.25,
     "ok": true
    },
    {
     "text": "同一刻的",
     "kind": "title",
     "units": 4,
     "on_s": 3.9,
     "need_s": 1.0,
     "ok": true
    },
    {
     "text": "用我拍下的，",
     "kind": "title",
     "units": 5,
     "on_s": 1.95,
     "need_s": 1.25,
     "ok": true
    },
    {
     "text": "换 TA 看到的。",
     "kind": "title",
     "units": 5,
     "on_s": 1.95,
     "need_s": 1.25,
     "ok": true
    },
    {
     "text": "换不换，",
     "kind": "title",
     "units": 3,
     "on_s": 1.95,
     "need_s": 0.8,
     "ok": true
    },
    {
     "text": "你们俩说了算。",
     "kind": "title",
     "units": 6,
     "on_s": 1.95,
     "need_s": 1.5,
     "ok": true
    },
    {
     "text": "我同意，",
     "kind": "title",
     "units": 3,
     "on_s": 1.95,
     "need_s": 0.8,
     "ok": true
    },
    {
     "text": "交给 TA 确认。",
     "kind": "title",
     "units": 5,
     "on_s": 2.0,
     "need_s": 1.25,
     "ok": true
    },
    {
     "text": "还要 TA\n也同意。",
     "kind": "title",
     "units": 6,
     "on_s": 2.0,
     "need_s": 1.5,
     "ok": true
    },
    {
     "text": "双方同意，",
     "kind": "title",
     "units": 4,
     "on_s": 3.9,
     "need_s": 1.0,
     "ok": true
    },
    {
     "text": "才交换。",
     "kind": "title",
     "units": 3,
     "on_s": 2.95,
     "need_s": 0.8,
     "ok": true
    },
    {
     "text": "双方已明确同意",
     "kind": "label",
     "units": 7,
     "on_s": 2.15,
     "need_s": 1.75,
     "ok": true
    },
    {
     "text": "两面\n都齐了。",
     "kind": "title",
     "units": 5,
     "on_s": 1.95,
     "need_s": 1.25,
     "ok": true
    },
    {
     "text": "随时可以撤销。",
     "kind": "title",
     "units": 6,
     "on_s": 2.0,
     "need_s": 1.5,
     "ok": true
    },
    {
     "text": "然后呢？",
     "kind": "title",
     "units": 3,
     "on_s": 1.85,
     "need_s": 0.8,
     "ok": true
    },
    {
     "text": "先招招手，",
     "kind": "title",
     "units": 4,
     "on_s": 2.95,
     "need_s": 1.0,
     "ok": true
    },
    {
     "text": "对方愿意，\n才成朋友。",
     "kind": "title",
     "units": 8,
     "on_s": 2.9,
     "need_s": 2.0,
     "ok": true
    },
    {
     "text": "私聊，",
     "kind": "title",
     "units": 2,
     "on_s": 3.0,
     "need_s": 0.8,
     "ok": true
    },
    {
     "text": "从返场那首聊起。",
     "kind": "title",
     "units": 7,
     "on_s": 2.95,
     "need_s": 1.75,
     "ok": true
    },
    {
     "text": "想安静的人，",
     "kind": "title",
     "units": 5,
     "on_s": 2.0,
     "need_s": 1.25,
     "ok": true
    },
    {
     "text": "不接收新招呼。",
     "kind": "title",
     "units": 6,
     "on_s": 2.0,
     "need_s": 1.5,
     "ok": true
    },
    {
     "text": "散场以后，\n继续聊。",
     "kind": "title",
     "units": 7,
     "on_s": 3.0,
     "need_s": 1.75,
     "ok": true
    },
    {
     "text": "今晚的\n专辑世界杯，",
     "kind": "title",
     "units": 8,
     "on_s": 3.0,
     "need_s": 2.0,
     "ok": true
    },
    {
     "text": "选一张，一起聊。",
     "kind": "title",
     "units": 6,
     "on_s": 2.0,
     "need_s": 1.5,
     "ok": true
    },
    {
     "text": "2票",
     "kind": "label",
     "units": 2,
     "on_s": 0.95,
     "need_s": 0.8,
     "ok": true
    },
    {
     "text": "默契局：",
     "kind": "title",
     "units": 3,
     "on_s": 2.0,
     "need_s": 0.8,
     "ok": true
    },
    {
     "text": "揭晓前，谁也看不到。",
     "kind": "title",
     "units": 8,
     "on_s": 2.9,
     "need_s": 2.0,
     "ok": true
    },
    {
     "text": "选到一起了！",
     "kind": "title",
     "units": 5,
     "on_s": 1.9,
     "need_s": 1.25,
     "ok": true
    },
    {
     "text": "Livehouse 的\n长期社群，",
     "kind": "title",
     "units": 6,
     "on_s": 2.0,
     "need_s": 1.5,
     "ok": true
    },
    {
     "text": "也给你\n留一个位置。",
     "kind": "title",
     "units": 8,
     "on_s": 3.0,
     "need_s": 2.0,
     "ok": true
    },
    {
     "text": "再见，\n在下一场。",
     "kind": "title",
     "units": 6,
     "on_s": 2.0,
     "need_s": 1.5,
     "ok": true
    },
    {
     "text": "创作角：",
     "kind": "title",
     "units": 3,
     "on_s": 2.0,
     "need_s": 0.8,
     "ok": true
    },
    {
     "text": "对方点头，才开始。",
     "kind": "title",
     "units": 7,
     "on_s": 2.0,
     "need_s": 1.75,
     "ok": true
    },
    {
     "text": "把这一晚，\n留在手里。",
     "kind": "title",
     "units": 8,
     "on_s": 2.95,
     "need_s": 2.0,
     "ok": true
    },
    {
     "text": "纪念卡，",
     "kind": "title",
     "units": 3,
     "on_s": 2.0,
     "need_s": 0.8,
     "ok": true
    },
    {
     "text": "在你的浏览器里生成。",
     "kind": "title",
     "units": 9,
     "on_s": 2.5,
     "need_s": 2.25,
     "ok": true
    },
    {
     "text": "散场后，\n仍有地方回来。",
     "kind": "title",
     "units": 9,
     "on_s": 3.0,
     "need_s": 2.25,
     "ok": true
    },
    {
     "text": "Livehouse 开个房，",
     "kind": "title",
     "units": 4,
     "on_s": 3.9,
     "need_s": 1.0,
     "ok": true
    },
    {
     "text": "乐迷留在\n本地社群。",
     "kind": "title",
     "units": 8,
     "on_s": 2.9,
